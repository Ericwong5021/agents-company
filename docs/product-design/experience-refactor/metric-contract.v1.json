{
  "schemaVersion": 1,
  "id": "agent-company-experience-metrics",
  "version": "1.1.0",
  "queryVersion": "seed-grow-metric-query.v1",
  "privacy": {
    "storage": "local_first",
    "externalUploadDefault": false,
    "prohibitedProperties": ["api_key", "full_prompt", "file_content", "credential", "access_token", "refresh_token"],
    "retention": "Keep raw benchmark events only inside the isolated run directory; retain aggregate results and redacted evidence by explicit release decision."
  },
  "eventEnvelope": {
    "requiredFields": {
      "eventId": "string",
      "eventType": "string",
      "occurredAt": "ISO-8601 timestamp",
      "buildSha": "40-character git commit",
      "scenarioId": "S01-S27 or null",
      "runId": "string",
      "subjectId": "pseudonymous local identifier",
      "properties": "object"
    },
    "requiredOrdering": ["occurredAt", "eventId"],
    "duplicateKey": "eventId",
    "clockPolicy": "Use monotonic duration for elapsed-time metrics and wall clock only for audit timestamps."
  },
  "eventTypes": [
    {
      "id": "provider.connection_succeeded",
      "requiredProperties": ["providerKind"]
    },
    {
      "id": "goal.submitted",
      "requiredProperties": ["intent", "source"]
    },
    {
      "id": "goal.brief_visible",
      "requiredProperties": ["briefId", "briefVersion"]
    },
    {
      "id": "goal.work_started",
      "requiredProperties": ["briefId", "actionCount"]
    },
    {
      "id": "user.interruption_presented",
      "requiredProperties": ["kind", "materialityReason"]
    },
    {
      "id": "user.interruption_judged",
      "requiredProperties": ["needed"]
    },
    {
      "id": "connection.lost",
      "requiredProperties": ["reasonKind"]
    },
    {
      "id": "connection.recovered",
      "requiredProperties": ["contextPreserved", "duplicateSideEffects"]
    },
    {
      "id": "delivery.presented",
      "requiredProperties": ["deliveryId", "artifactCount", "noFileReason"]
    },
    {
      "id": "delivery.artifact_opened",
      "requiredProperties": ["deliveryId", "artifactId", "succeeded"]
    },
    {
      "id": "delivery.criterion_evaluated",
      "requiredProperties": ["deliveryId", "criterionId", "status", "evidenceCount"]
    },
    {
      "id": "benchmark.completed",
      "requiredProperties": ["scenarioId", "finalDecision"]
    },
    {
      "id": "trust.false_state_detected",
      "requiredProperties": ["surface", "kind"]
    },
    {
      "id": "work_receipt.submitted",
      "requiredProperties": ["receiptId", "attemptId", "sourceRefCount"]
    },
    {
      "id": "work_receipt.processed",
      "requiredProperties": ["receiptId", "duplicate", "recovered"]
    },
    {
      "id": "graph_decision.recorded",
      "requiredProperties": ["decisionId", "kind", "automated", "addedNodeCount"]
    },
    {
      "id": "graph_mutation.evaluated",
      "requiredProperties": ["mutationId", "evidenceCount", "verdict"]
    },
    {
      "id": "graph_mutation.recovered",
      "requiredProperties": ["mutationId", "consistent", "duplicateSideEffects"]
    },
    {
      "id": "graph_repair.completed",
      "requiredProperties": ["repairId", "passedOriginalCriterion", "attemptCount"]
    },
    {
      "id": "validation_gate.evaluated",
      "requiredProperties": ["gateId", "passed", "anchorPassed", "falsePass"]
    },
    {
      "id": "project_assignment.activated",
      "requiredProperties": ["assignmentId", "agentId", "purpose", "initial"]
    },
    {
      "id": "project_assignment.released",
      "requiredProperties": ["assignmentId", "agentId", "durationMs"]
    },
    {
      "id": "candidate.selected",
      "requiredProperties": ["candidateId", "reused", "createdForNeed"]
    },
    {
      "id": "review.completed",
      "requiredProperties": ["risk", "invoked", "rejected", "findingConfirmed"]
    },
    {
      "id": "repair.circuit_opened",
      "requiredProperties": ["workItemId", "attemptCount", "attentionId"]
    },
    {
      "id": "delivery.quality_compared",
      "requiredProperties": ["risk", "strategy", "legacyScore", "seedGrowScore"]
    },
    {
      "id": "model.cost_recorded",
      "requiredProperties": ["acceptedDeliveryId", "tokens", "cost"]
    },
    {
      "id": "model.usage_recorded",
      "requiredProperties": ["runId", "strategy", "purpose", "modelCalls", "tokens", "cost"]
    },
    {
      "id": "project.completed",
      "requiredProperties": ["projectId", "strategy"]
    },
    {
      "id": "work_attempt.finished",
      "requiredProperties": ["attemptId", "outcome", "retry", "diagnosed", "cost", "reusableKnowledge"]
    },
    {
      "id": "attention.opened",
      "requiredProperties": ["attentionId", "materiality", "interruptsUser"]
    },
    {
      "id": "attention.judged",
      "requiredProperties": ["attentionId", "valid"]
    },
    {
      "id": "attention.resolved",
      "requiredProperties": ["attentionId", "latencyMs"]
    },
    {
      "id": "delivery.accepted",
      "requiredProperties": ["deliveryId"]
    },
    {
      "id": "candidate.terminal_checked",
      "requiredProperties": ["candidateSha", "isolatedRunIndex", "localGate", "deployment", "rollback", "reproducible"]
    },
    {
      "id": "shadow.compared",
      "requiredProperties": ["comparisonId", "legacyRunId", "seedGrowRunId"]
    },
    {
      "id": "research.sus_recorded",
      "requiredProperties": ["studyId", "participantId", "score"]
    },
    {
      "id": "research.state_comprehension_recorded",
      "requiredProperties": ["studyId", "participantId", "correct", "total"]
    }
  ],
  "metrics": [
    {
      "id": "activation_success_rate",
      "label": "First activation success rate",
      "definition": "Share of new isolated workspaces that connect a real or deterministic test Provider and submit the first Goal.",
      "formula": "subjects(provider.connection_succeeded AND goal.submitted) / eligible_new_workspace_subjects",
      "unit": "ratio",
      "aggregation": "ratio",
      "collectionMode": "automated",
      "minimumEvidence": ["provider.connection_succeeded", "goal.submitted"],
      "target": {
        "gate": "R3",
        "operator": ">=",
        "value": 0.8
      }
    },
    {
      "id": "goal_to_start_actions",
      "label": "Goal-to-Start",
      "definition": "Number of primary user actions from Goal submission through formal work start.",
      "formula": "median(goal.work_started.actionCount)",
      "unit": "actions",
      "aggregation": "median",
      "collectionMode": "automated",
      "minimumEvidence": ["goal.submitted", "goal.work_started"],
      "target": {
        "gate": "R3",
        "operator": "<=",
        "value": 3
      }
    },
    {
      "id": "brief_time_to_first_value_ms",
      "label": "Brief time to first value",
      "definition": "Elapsed monotonic time from Goal submission until the structured Goal Brief is visible.",
      "formula": "p95(goal.brief_visible.monotonicTime - goal.submitted.monotonicTime)",
      "unit": "milliseconds",
      "aggregation": "p95",
      "collectionMode": "automated",
      "minimumEvidence": ["goal.submitted", "goal.brief_visible"],
      "target": {
        "gate": "R3",
        "operator": "<=",
        "value": 60000
      }
    },
    {
      "id": "delivery_consumability_rate",
      "label": "Delivery consumability rate",
      "definition": "Share of Delivered work with at least one successfully opened artifact or an explicit valid no-file reason.",
      "formula": "consumable_deliveries / presented_deliveries",
      "numerator": "deliveries with an opened artifact or a valid no-file reason",
      "denominator": "presented deliveries",
      "eventSource": ["delivery.presented", "delivery.artifact_opened"],
      "timeWindow": "candidate benchmark run",
      "minimumSampleSize": 2,
      "unit": "ratio",
      "aggregation": "ratio",
      "collectionMode": "automated",
      "minimumEvidence": ["delivery.presented", "delivery.artifact_opened"],
      "target": {
        "gate": "R3",
        "operator": "=",
        "value": 1
      }
    },
    {
      "id": "acceptance_determinability_rate",
      "label": "Acceptance determinability rate",
      "definition": "Share of delivery criteria with an explicit status and at least one evidence item or an explicit evidence-not-applicable reason.",
      "formula": "determinable_criteria / delivery_criteria",
      "numerator": "criteria with a deterministic status and admissible evidence",
      "denominator": "delivery criteria",
      "eventSource": ["delivery.criterion_evaluated"],
      "timeWindow": "candidate benchmark run",
      "minimumSampleSize": 2,
      "unit": "ratio",
      "aggregation": "ratio",
      "collectionMode": "automated",
      "minimumEvidence": ["delivery.criterion_evaluated"],
      "target": {
        "gate": "R3",
        "operator": "=",
        "value": 1
      }
    },
    {
      "id": "core_task_completion_rate",
      "label": "Core task completion rate",
      "definition": "Share of benchmark runs that pass every blocking criterion and produce an acceptable result.",
      "formula": "benchmark_runs(finalDecision = pass) / eligible_benchmark_runs",
      "numerator": "eligible benchmark runs with finalDecision = pass",
      "denominator": "eligible benchmark runs",
      "eventSource": ["benchmark.completed"],
      "timeWindow": "two consecutive candidate benchmark runs",
      "minimumSampleSize": 2,
      "unit": "ratio",
      "aggregation": "ratio",
      "collectionMode": "hybrid",
      "minimumEvidence": ["benchmark.completed", "criterionResults", "human rubric when declared by the scenario"],
      "target": {
        "gate": "R3",
        "operator": ">=",
        "value": 0.7
      }
    },
    {
      "id": "unnecessary_interruption_rate",
      "label": "Unnecessary interruption rate",
      "definition": "Share of presented clarification or approval interruptions judged unnecessary by the target user or the scenario materiality oracle.",
      "formula": "interruptions(needed = false) / judged_interruptions",
      "unit": "ratio",
      "aggregation": "ratio",
      "collectionMode": "hybrid",
      "minimumEvidence": ["user.interruption_presented", "user.interruption_judged"],
      "target": {
        "gate": "R3",
        "operator": "<",
        "value": 0.2
      }
    },
    {
      "id": "recovery_success_rate",
      "label": "Recovery success rate",
      "definition": "Share of injected disconnect or restart runs that restore context without data loss or duplicate side effects.",
      "formula": "recoveries(contextPreserved = true AND duplicateSideEffects = 0) / eligible_recovery_injections",
      "numerator": "recoveries preserving context without duplicate side effects",
      "denominator": "eligible recovery injections",
      "eventSource": ["connection.lost", "connection.recovered"],
      "timeWindow": "candidate recovery matrix",
      "minimumSampleSize": 2,
      "unit": "ratio",
      "aggregation": "ratio",
      "collectionMode": "automated",
      "minimumEvidence": ["connection.lost", "connection.recovered", "side-effect ledger"],
      "target": {
        "gate": "R3",
        "operator": "=",
        "value": 1
      }
    },
    {
      "id": "false_success_or_data_count",
      "label": "False success or false data",
      "definition": "Count of user-visible fixtures, invented records, false progress, or success states without authoritative evidence.",
      "formula": "count(trust.false_state_detected)",
      "unit": "count",
      "aggregation": "sum",
      "collectionMode": "automated",
      "minimumEvidence": ["trust.false_state_detected", "fault-injection DOM and API assertions"],
      "target": {
        "gate": "R0",
        "operator": "=",
        "value": 0
      }
    },
    {
      "id": "false_completion_count",
      "label": "False completion count",
      "definition": "Count of completed project or delivery states whose blocking work, Receipt, Mutation, Gate, or acceptance facts were not terminal.",
      "formula": "count(trust.false_state_detected where kind = false_completion)",
      "numerator": "false completion detections",
      "denominator": "eligible completed project and delivery states",
      "eventSource": ["trust.false_state_detected", "project.completed", "benchmark.completed"],
      "timeWindow": "two consecutive candidate benchmark runs",
      "minimumSampleSize": 2,
      "unit": "count",
      "aggregation": "sum",
      "collectionMode": "automated",
      "minimumEvidence": ["trust.false_state_detected", "project terminal invariant report", "benchmark.completed"],
      "target": {
        "gate": "R4",
        "operator": "=",
        "value": 0
      }
    },
    {
      "id": "acceptance_criterion_evidence_coverage",
      "label": "Acceptance criterion evidence coverage",
      "definition": "Share of acceptance criteria backed by at least one current deterministic evidence reference.",
      "formula": "criteria(evidenceCount > 0 AND evidenceCurrent = true) / eligible_acceptance_criteria",
      "numerator": "criteria with current deterministic evidence",
      "denominator": "eligible acceptance criteria",
      "eventSource": ["delivery.criterion_evaluated", "validation_gate.evaluated"],
      "timeWindow": "candidate benchmark run",
      "minimumSampleSize": 2,
      "unit": "ratio",
      "aggregation": "ratio",
      "collectionMode": "automated",
      "minimumEvidence": ["delivery.criterion_evaluated", "validation gate evidence refs"],
      "target": {
        "gate": "R4",
        "operator": "=",
        "value": 1
      }
    },
    {
      "id": "complex_initial_assignment_median",
      "label": "Complex project initial Assignment median",
      "definition": "Median active Assignment count before the first Receipt for eligible complex projects.",
      "formula": "median(count(project_assignment.activated where initial = true before first work_receipt.submitted))",
      "numerator": "initial active Assignment count per eligible complex project",
      "denominator": "eligible complex projects",
      "eventSource": ["project_assignment.activated", "work_receipt.submitted"],
      "timeWindow": "candidate benchmark run",
      "minimumSampleSize": 2,
      "unit": "assignments",
      "aggregation": "median",
      "collectionMode": "automated",
      "minimumEvidence": ["project_assignment.activated", "work_receipt.submitted", "seed policy verdict"],
      "target": {
        "gate": "R4",
        "operator": "=",
        "value": 2
      }
    },
    {
      "id": "graph_mutation_without_evidence_rate",
      "label": "Graph mutation without evidence rate",
      "definition": "Share of evaluated graph mutations whose evidence set is empty.",
      "formula": "graph_mutation.evaluated(evidenceCount = 0) / graph_mutation.evaluated",
      "numerator": "mutations with evidenceCount = 0",
      "denominator": "evaluated mutations",
      "eventSource": ["graph_mutation.evaluated"],
      "timeWindow": "candidate benchmark run",
      "minimumSampleSize": 1,
      "unit": "ratio",
      "aggregation": "ratio",
      "collectionMode": "automated",
      "minimumEvidence": ["graph_mutation.evaluated", "sourceRefs"],
      "target": {
        "gate": "R4",
        "operator": "=",
        "value": 0
      }
    },
    {
      "id": "agent_count_before_first_receipt",
      "label": "Agent count before first Receipt",
      "definition": "Median distinct active Agent count observed before the first Receipt in each eligible project.",
      "formula": "median(distinct active agents before first work_receipt.submitted)",
      "numerator": "distinct active Agent count before first Receipt per project",
      "denominator": "eligible projects with a first Receipt",
      "eventSource": ["project_assignment.activated", "project_assignment.released", "work_receipt.submitted"],
      "timeWindow": "candidate benchmark run",
      "minimumSampleSize": 2,
      "unit": "assignments",
      "aggregation": "median",
      "collectionMode": "automated",
      "minimumEvidence": ["Assignment history", "first Receipt binding"],
      "target": {
        "gate": "R4",
        "operator": "observe",
        "value": null
      }
    },
    {
      "id": "agent_count_added_after_receipt",
      "label": "Agent count added after Receipt",
      "definition": "Median distinct Agent count added only after an evidence-bearing Receipt establishes a new need.",
      "formula": "median(distinct agents first activated after work_receipt.submitted)",
      "numerator": "distinct post-Receipt Agent additions per project",
      "denominator": "eligible projects with an evidence-bearing Receipt",
      "eventSource": ["work_receipt.submitted", "project_assignment.activated"],
      "timeWindow": "candidate benchmark run",
      "minimumSampleSize": 2,
      "unit": "assignments",
      "aggregation": "median",
      "collectionMode": "automated",
      "minimumEvidence": ["Receipt source refs", "Assignment activation history"],
      "target": {
        "gate": "R4",
        "operator": "observe",
        "value": null
      }
    },
    {
      "id": "receipt_recovery_success_rate",
      "label": "Receipt recovery success rate",
      "definition": "Share of injected Receipt-boundary restarts that process the Receipt exactly once.",
      "formula": "work_receipt.processed(recovered = true AND duplicate = false) / eligible_receipt_restart_injections",
      "numerator": "successful exactly-once recovered Receipts",
      "denominator": "eligible Receipt restart injections",
      "eventSource": ["work_receipt.submitted", "work_receipt.processed", "connection.lost", "connection.recovered"],
      "timeWindow": "candidate recovery matrix",
      "minimumSampleSize": 2,
      "unit": "ratio",
      "aggregation": "ratio",
      "collectionMode": "automated",
      "minimumEvidence": ["kill-point trace", "work_receipt.processed", "database invariant"],
      "target": {
        "gate": "R4",
        "operator": "=",
        "value": 1
      }
    },
    {
      "id": "graph_mutation_recovery_success_rate",
      "label": "Graph mutation recovery success rate",
      "definition": "Share of mutation-boundary restarts that recover a consistent graph without duplicate side effects.",
      "formula": "graph_mutation.recovered(consistent = true AND duplicateSideEffects = 0) / eligible_mutation_restart_injections",
      "numerator": "consistent mutation recoveries without duplicate side effects",
      "denominator": "eligible mutation restart injections",
      "eventSource": ["graph_mutation.recovered", "connection.lost", "connection.recovered"],
      "timeWindow": "candidate recovery matrix",
      "minimumSampleSize": 2,
      "unit": "ratio",
      "aggregation": "ratio",
      "collectionMode": "automated",
      "minimumEvidence": ["kill-point trace", "graph snapshots", "side-effect ledger"],
      "target": {
        "gate": "R4",
        "operator": "=",
        "value": 1
      }
    },
    {
      "id": "graph_repair_success_rate",
      "label": "Graph repair success rate",
      "definition": "Share of completed graph repairs that pass the unchanged original criterion.",
      "formula": "graph_repair.completed(passedOriginalCriterion = true) / graph_repair.completed",
      "numerator": "repairs passing the original criterion",
      "denominator": "completed graph repairs",
      "eventSource": ["graph_repair.completed", "validation_gate.evaluated"],
      "timeWindow": "candidate benchmark run",
      "minimumSampleSize": 1,
      "unit": "ratio",
      "aggregation": "ratio",
      "collectionMode": "automated",
      "minimumEvidence": ["repair trace", "original criterion digest", "validation gate verdict"],
      "target": {
        "gate": "R4",
        "operator": "=",
        "value": 1
      }
    },
    {
      "id": "blind_retry_rate",
      "label": "Blind retry rate",
      "definition": "Share of retries without a registered diagnosis or changed implementation/environment fact.",
      "formula": "retries(without diagnosis or changed fact) / retries",
      "numerator": "blind retries",
      "denominator": "all retries",
      "eventSource": ["graph_repair.completed", "repair.circuit_opened"],
      "timeWindow": "candidate benchmark run",
      "minimumSampleSize": 1,
      "unit": "ratio",
      "aggregation": "ratio",
      "collectionMode": "automated",
      "minimumEvidence": ["attempt ledger", "diagnosis record", "repair diff"],
      "target": {
        "gate": "R4",
        "operator": "=",
        "value": 0
      }
    },
    {
      "id": "validation_gate_false_pass_rate",
      "label": "Validation gate false-pass rate",
      "definition": "Share of passed validation gates whose registered reality anchor did not pass.",
      "formula": "validation_gate.evaluated(passed = true AND anchorPassed = false) / validation_gate.evaluated(passed = true)",
      "numerator": "passed gates with failed anchors",
      "denominator": "passed validation gates",
      "eventSource": ["validation_gate.evaluated"],
      "timeWindow": "candidate benchmark run",
      "minimumSampleSize": 1,
      "unit": "ratio",
      "aggregation": "ratio",
      "collectionMode": "automated",
      "minimumEvidence": ["validation_gate.evaluated", "anchor report"],
      "target": {
        "gate": "R4",
        "operator": "=",
        "value": 0
      }
    },
    {
      "id": "candidate_reuse_rate",
      "label": "Candidate reuse rate",
      "definition": "Share of eligible selections that reuse a compatible Candidate.",
      "formula": "candidate.selected(reused = true) / candidate.selected",
      "numerator": "reused Candidate selections",
      "denominator": "eligible Candidate selections",
      "eventSource": ["candidate.selected"],
      "timeWindow": "two consecutive candidate benchmark runs",
      "minimumSampleSize": 2,
      "unit": "ratio",
      "aggregation": "ratio",
      "collectionMode": "automated",
      "minimumEvidence": ["candidate.selected", "selection hard-constraint report"],
      "target": {
        "gate": "R4",
        "operator": ">=",
        "value": 0.5
      }
    },
    {
      "id": "candidate_reuse_delta_vs_legacy",
      "label": "Candidate reuse delta versus legacy",
      "definition": "Seed-and-grow Candidate reuse rate minus the matched legacy Candidate reuse rate.",
      "formula": "seed_grow_candidate_reuse_rate - legacy_candidate_reuse_rate",
      "numerator": "matched Candidate reuse-rate delta",
      "denominator": "matched legacy and seed_and_grow shadow comparison pairs",
      "eventSource": ["candidate.selected", "shadow.compared"],
      "timeWindow": "matched shadow comparison across two candidates",
      "minimumSampleSize": 2,
      "unit": "ratio",
      "aggregation": "ratio",
      "collectionMode": "automated",
      "minimumEvidence": ["candidate.selected", "shadow source binding", "strategy binding"],
      "target": {
        "gate": "R4",
        "operator": ">",
        "value": 0
      }
    },
    {
      "id": "new_candidate_per_completed_project",
      "label": "New Candidate per completed project",
      "definition": "New Candidates created for Needs divided by completed eligible projects.",
      "formula": "candidate.selected(createdForNeed = true) / eligible_completed_projects",
      "numerator": "Candidates created for a Need",
      "denominator": "eligible completed projects",
      "eventSource": ["candidate.selected", "benchmark.completed"],
      "timeWindow": "two consecutive candidate benchmark runs",
      "minimumSampleSize": 2,
      "unit": "candidates_per_project",
      "aggregation": "ratio",
      "collectionMode": "automated",
      "minimumEvidence": ["candidate.selected", "benchmark.completed"],
      "target": {
        "gate": "R4",
        "operator": "<=",
        "value": 0.5
      }
    },
    {
      "id": "unnecessary_reviewer_rate",
      "label": "Unnecessary Reviewer rate",
      "definition": "Share of low-risk work that invoked a Reviewer without a registered risk trigger.",
      "formula": "review.completed(risk = low AND invoked = true) / eligible_low_risk_work",
      "numerator": "low-risk work with Reviewer invocation",
      "denominator": "eligible low-risk work",
      "eventSource": ["review.completed"],
      "timeWindow": "candidate benchmark run",
      "minimumSampleSize": 2,
      "unit": "ratio",
      "aggregation": "ratio",
      "collectionMode": "automated",
      "minimumEvidence": ["review.completed", "validation policy verdict"],
      "target": {
        "gate": "R4",
        "operator": "=",
        "value": 0
      }
    },
    {
      "id": "reviewer_rejection_precision",
      "label": "Reviewer rejection precision",
      "definition": "Share of Reviewer rejections confirmed by the registered validation anchor.",
      "formula": "review.completed(rejected = true AND findingConfirmed = true) / review.completed(rejected = true)",
      "numerator": "confirmed Reviewer rejections",
      "denominator": "Reviewer rejections",
      "eventSource": ["review.completed", "validation_gate.evaluated"],
      "timeWindow": "two consecutive candidate benchmark runs",
      "minimumSampleSize": 1,
      "unit": "ratio",
      "aggregation": "ratio",
      "collectionMode": "automated",
      "minimumEvidence": ["review.completed", "validation anchor"],
      "target": {
        "gate": "R4",
        "operator": ">=",
        "value": 0.8
      }
    },
    {
      "id": "reviewer_invocation_ratio_vs_legacy",
      "label": "Reviewer invocation ratio versus legacy",
      "definition": "Reviewer invocations per eligible work item under seed_and_grow divided by the matched legacy rate.",
      "formula": "seed_grow_reviewer_invocations_per_work / legacy_reviewer_invocations_per_work",
      "numerator": "seed_and_grow Reviewer invocations per eligible work item",
      "denominator": "matched legacy Reviewer invocations per eligible work item",
      "eventSource": ["review.completed", "benchmark.completed"],
      "timeWindow": "matched shadow comparison across two candidates",
      "minimumSampleSize": 2,
      "unit": "ratio",
      "aggregation": "ratio",
      "collectionMode": "automated",
      "minimumEvidence": ["shadow comparison", "review.completed", "strategy binding"],
      "target": {
        "gate": "R4",
        "operator": "<",
        "value": 1
      }
    },
    {
      "id": "agent_load_balance",
      "label": "Agent load balance",
      "definition": "Maximum active Assignment share held by one Agent in eligible concurrent work.",
      "formula": "max(active_assignments_by_agent) / active_assignments",
      "numerator": "maximum active Assignment count for one Agent",
      "denominator": "active Assignments",
      "eventSource": ["project_assignment.activated", "project_assignment.released"],
      "timeWindow": "candidate benchmark run",
      "minimumSampleSize": 2,
      "unit": "ratio",
      "aggregation": "max",
      "collectionMode": "automated",
      "minimumEvidence": ["Assignment timeline"],
      "target": {
        "gate": "R4",
        "operator": "<=",
        "value": 0.75
      }
    },
    {
      "id": "automated_graph_decision_rate",
      "label": "Automated graph decision rate",
      "definition": "Share of Graph Decisions resolved without user attention while remaining inside policy.",
      "formula": "graph_decision.recorded(automated = true) / graph_decision.recorded",
      "numerator": "automated Graph Decisions",
      "denominator": "Graph Decisions",
      "eventSource": ["graph_decision.recorded"],
      "timeWindow": "candidate benchmark run",
      "minimumSampleSize": 2,
      "unit": "ratio",
      "aggregation": "ratio",
      "collectionMode": "automated",
      "minimumEvidence": ["graph_decision.recorded", "policy verdict"],
      "target": {
        "gate": "R4",
        "operator": ">=",
        "value": 0.8
      }
    },
    {
      "id": "user_attention_count",
      "label": "User Attention count",
      "definition": "Count of material Attention items that actually interrupted the user.",
      "formula": "count(attention.opened where interruptsUser = true)",
      "numerator": "user-interrupting Attention items",
      "denominator": "eligible benchmark runs",
      "eventSource": ["attention.opened"],
      "timeWindow": "candidate benchmark run",
      "minimumSampleSize": 2,
      "unit": "count",
      "aggregation": "sum",
      "collectionMode": "automated",
      "minimumEvidence": ["Attention row", "attention.opened"],
      "target": {
        "gate": "R4",
        "operator": "observe",
        "value": null
      }
    },
    {
      "id": "invalid_interruption_rate",
      "label": "Invalid interruption rate",
      "definition": "Share of presented interruptions not justified by permission, scope, external effect or unresolved material risk.",
      "formula": "interruptions(needed = false) / judged_interruptions",
      "numerator": "invalid interruptions",
      "denominator": "judged interruptions",
      "eventSource": ["user.interruption_presented", "user.interruption_judged"],
      "timeWindow": "candidate benchmark run",
      "minimumSampleSize": 2,
      "unit": "ratio",
      "aggregation": "ratio",
      "collectionMode": "automated",
      "minimumEvidence": ["Attention materiality report", "user.interruption_judged"],
      "target": {
        "gate": "R4",
        "operator": "<",
        "value": 0.2
      }
    },
    {
      "id": "material_attention_precision",
      "label": "Material Attention precision",
      "definition": "Share of scope, permission, external-effect, and unresolved-risk interruptions confirmed as valid by deterministic scenario or policy facts.",
      "formula": "attention.judged(valid = true) / judged material attention",
      "numerator": "valid material Attention interruptions",
      "denominator": "judged material Attention interruptions",
      "eventSource": ["attention.opened", "attention.judged"],
      "timeWindow": "candidate benchmark run",
      "minimumSampleSize": 2,
      "unit": "ratio",
      "aggregation": "ratio",
      "collectionMode": "automated",
      "minimumEvidence": ["Attention materiality", "attention.judged", "scenario oracle or policy fact"],
      "target": {
        "gate": "R4",
        "operator": "observe",
        "value": null
      }
    },
