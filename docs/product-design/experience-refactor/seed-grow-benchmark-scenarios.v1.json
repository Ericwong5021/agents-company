    {
      "id": "S26",
      "title": "Agent 复用",
      "seed": 260026,
      "runMode": "automated",
      "firstRequiredStage": "B0",
      "inputs": ["two projects with equivalent evidenced capability needs"],
      "expectedOutputs": ["eligible Candidate reused", "selection reason recorded", "no unnecessary Candidate"],
      "allowedQuestions": [],
      "acceptanceCriteria": [
        {
          "id": "S26-C1",
