      "failureConditions": ["historical deletion", "completed fact mutated", "replacement lacks source reference"],
      "observedMetrics": ["graph_repair_success_rate", "graph_mutation_without_evidence_rate"],
      "humanEvidenceRequired": []
    },
    {
      "id": "S24",
      "title": "项目完成判定",
      "seed": 240024,
      "runMode": "automated",
      "firstRequiredStage": "B2",
      "inputs": ["no ready work while Receipt or Mutation remains pending"],
