      "failureConditions": ["fourth automatic attempt", "criterion weakened", "duplicate Attention"],
      "observedMetrics": ["three_round_circuit_breaker_count", "blind_retry_rate"],
      "humanEvidenceRequired": []
    },
    {
      "id": "S23",
      "title": "前置节点错误",
      "seed": 230023,
      "runMode": "automated",
      "firstRequiredStage": "A3",
      "inputs": ["completed branch derived from a false prerequisite"],
      "expectedOutputs": ["superseded branch retained", "replacement branch linked", "history preserved"],
      "allowedQuestions": [],
      "acceptanceCriteria": [
        {
          "id": "S23-C1",
          "statement": "Invalidated descendants are superseded without deleting historical artifacts or events.",
