{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-company.local/schema/founder-os-w0-evidence.v1.json",
  "title": "Agent Company Founder OS W0 exact-commit attempt evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageVersion",
    "attemptId",
    "candidateSha",
    "candidateTreeSha",
    "baseSha",
    "contractBinding",
    "schemaBinding",
    "runnerBinding",
    "isolation",
    "githubActions",
    "authorization",
    "artifacts",
    "startedAt",
    "finishedAt",
    "commands",
    "normalizedDigest",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "packageVersion": {
      "const": "1.1.0"
    },
    "attemptId": {
      "enum": [
        "attempt-01",
        "attempt-02"
      ]
    },
    "candidateSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "candidateTreeSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "baseSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "contractBinding": {
      "$ref": "#/$defs/sourceBinding"
    },
    "schemaBinding": {
      "$ref": "#/$defs/sourceBinding"
    },
    "runnerBinding": {
      "$ref": "#/$defs/sourceBinding"
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "detachedHead",
        "cleanTrackedFiles"
      ],
      "properties": {
        "mode": {
          "const": "detached_exact_commit_worktree"
        },
        "detachedHead": {
          "const": true
        },
        "cleanTrackedFiles": {
          "const": true
        }
      }
    },
    "githubActions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "blocking",
        "replacement"
      ],
      "properties": {
        "status": {
          "const": "unavailable"
        },
        "blocking": {
          "const": false
        },
        "replacement": {
          "const": "two_local_exact_sha_runs"
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "blocking",
        "confirmedBy",
        "confirmedAt"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_confirmed",
            "confirmed",
            "rejected"
          ]
        },
        "blocking": {
          "const": false
        },
        "confirmedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "confirmedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateSha",
        "baseSha",
        "authorizationReport"
      ],
      "properties": {
        "candidateSha": {
          "$ref": "#/$defs/fileBinding"
        },
        "baseSha": {
          "$ref": "#/$defs/fileBinding"
        },
        "authorizationReport": {
          "$ref": "#/$defs/fileBinding"
        }
      }
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "commands": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "check",
          "argv",
          "cwd",
          "exitCode",
          "summary",
          "normalizedDigest",
          "stdout",
          "stderr",
          "report"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "check": {
            "type": "string",
            "minLength": 1
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "cwd": {
            "const": "."
          },
          "exitCode": {
            "type": "integer"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "normalizedDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "stdout": {
            "$ref": "#/$defs/fileBinding"
          },
          "stderr": {
            "$ref": "#/$defs/fileBinding"
          },
          "report": {
            "$ref": "#/$defs/fileBinding"
          }
        }
      }
    },
    "normalizedDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "pass",
        "failed",
        "invalid"
      ]
    }
  },
  "$defs": {
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relativePath",
        "sha256",
        "byteLength",
        "mediaType"
      ],
      "properties": {
        "relativePath": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0
        },
        "mediaType": {
          "enum": [
            "application/json",
            "text/plain"
          ]
        }
      }
    }
  }
}
