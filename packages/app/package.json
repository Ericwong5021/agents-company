{
  "name": "@agents-company/app",
  "version": "0.1.5-beta.8",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#*": "./agent/*"
  },
  "scripts": {
    "prebuild": "bun ./script/link-eve-dependencies.ts",
    "build": "bun ./script/run-nuxt.ts build",
    "predev": "bun ./script/link-eve-dependencies.ts",
    "dev": "bun ./script/dev.ts",
    "preview": "bun ./script/preview.ts",
    "pretypecheck": "bun ./script/link-eve-dependencies.ts",
    "typecheck": "bun ./script/run-nuxt.ts typecheck",
    "test": "bun run test:unit && bun run test:r0-shell",
    "test:unit": "bun test ./test",
    "test:r0-config-matrix": "bun ./script/r0-config-matrix.ts",
    "test:r0-shell": "playwright test --config playwright.config.ts --grep @r0-shell",
    "test:r0-candidates": "playwright test --config playwright.config.ts e2e/r0-candidates.spec.ts",
    "test:r1-r3": "playwright test --config playwright.config.ts --grep @r1-r3-flows",
    "test:production": "playwright test --config playwright.production.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "qa:visual": "bun ./script/visual-qa.ts"
  },
  "dependencies": {
    "@agents-company/sdk": "workspace:*",
    "@agents-company/shared": "workspace:*",
    "@comark/nuxt": "^0.5.0",
    "@github-tools/sdk": "^1.7.0",
    "@libsql/client": "^0.17.4",
    "@nuxt/kit": "4.4.8",
    "@nuxt/ui": "4.9.0",
    "@nuxthub/core": "0.10.7",
    "@shikijs/langs": "^4.3.1",
    "@vercel/connect": "0.3.2",
    "@vue-flow/background": "1.3.2",
    "@vue-flow/core": "1.48.2",
    "ai": "^7.0.16",
    "better-auth": "^1.6.23",
    "chat": "^4.32.0",
    "chat-adapter-sendblue": "^0.2.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "elkjs": "0.12.0",
    "eve": "^0.20.0",
    "h3": "^1.15.4",
    "maska": "^3.2.0",
    "nitropack": "^2.13.4",
    "nuxt": "4.4.8",
    "ofetch": "^1.5.1",
    "shiki": "^4.3.1",
    "tailwindcss": "^4.3.2",
    "vue": "3.5.39",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.116",
    "@iconify-json/simple-icons": "^1.2.89",
    "@playwright/test": "1.59.1",
    "@types/bun": "1.3.11",
    "@types/node": "26.1.0",
    "just-bash": "^3.0.0",
    "microsandbox": "^0.6.5",
    "typescript": "5.9.3",
    "vue-router": "5.2.0",
    "vue-tsc": "^3.3.6"
  },
  "optionalDependencies": {
    "@libsql/darwin-arm64": "0.5.29",
    "@libsql/darwin-x64": "0.5.29",
    "@libsql/linux-x64-gnu": "0.5.29",
    "@libsql/win32-x64-msvc": "0.5.29"
  }
}
