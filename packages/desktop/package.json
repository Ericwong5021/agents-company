{
  "name": "@agents-company/desktop",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Ericwong5021/agents-company",
  "author": {
    "name": "Agent Company",
    "email": "maintainers@agentcompany.ai"
  },
  "scripts": {
    "typecheck": "tsgo -b",
    "test:e2e": "bun run build && bun run test:node-entry && playwright test --config playwright.config.ts",
    "test:node-entry": "node --input-type=module -e \"await import('./out/main/chunks/node.js')\"",
    "predev": "bun ./scripts/predev.ts",
    "dev": "electron-vite dev",
    "prebuild": "bun ./scripts/prebuild.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-builder --config electron-builder.config.ts",
    "package:mac": "electron-builder --mac --config electron-builder.config.ts",
    "package:win": "electron-builder --win --config electron-builder.config.ts",
    "package:linux": "electron-builder --linux --config electron-builder.config.ts",
    "native:build": "bun install --cwd native"
  },
  "main": "./out/main/index.js",
  "dependencies": {
    "effect": "catalog:",
    "electron-context-menu": "4.1.2",
    "electron-log": "^5",
    "electron-store": "^10",
    "electron-updater": "^6",
    "electron-window-state": "^5.0.3",
    "drizzle-orm": "catalog:",
    "jsonc-parser": "3.3.1",
    "marked": "^15"
  },
  "devDependencies": {
    "@actions/artifact": "4.0.0",
    "@lydell/node-pty": "catalog:",
    "@agents-company/ui": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@valibot/to-json-schema": "1.6.0",
    "electron": "41.2.1",
    "electron-builder": "^26",
    "electron-vite": "^5",
    "sury": "11.0.0-alpha.4",
    "typescript": "~5.6.2",
    "vite": "catalog:",
    "zod-openapi": "5.4.6"
  },
  "optionalDependencies": {
    "@lydell/node-pty-darwin-arm64": "1.2.0-beta.10",
    "@lydell/node-pty-darwin-x64": "1.2.0-beta.10",
    "@lydell/node-pty-linux-arm64": "1.2.0-beta.10",
    "@lydell/node-pty-linux-x64": "1.2.0-beta.10",
    "@lydell/node-pty-win32-arm64": "1.2.0-beta.10",
    "@lydell/node-pty-win32-x64": "1.2.0-beta.10"
  }
}
